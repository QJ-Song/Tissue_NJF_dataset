#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 180
    framesPerSecond = 60
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 60
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene"
    {
    }

    def "Materials"
    {
        def Material "Tissue"
        {
            token outputs:surface.connect = </World/Materials/Tissue/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.35, 0.32)
                float inputs:metallic = 0
                float inputs:roughness = 0.82
                token outputs:surface
            }
        }

        def Material "BrushedSteel"
        {
            token outputs:surface.connect = </World/Materials/BrushedSteel/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.74, 0.76)
                float inputs:metallic = 0.15
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }

        def Material "MatteTable"
        {
            token outputs:surface.connect = </World/Materials/MatteTable/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.13, 0.16, 0.17)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }

        def Material "ContactMarker"
        {
            token outputs:surface.connect = </World/Materials/ContactMarker/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.08, 0.04)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Cube "Table"
    {
        rel material:binding = </World/Materials/MatteTable>
        float3 xformOp:scale = (0.8, 0.55, 0.02)
        double3 xformOp:translate = (0, 0, -0.085)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

